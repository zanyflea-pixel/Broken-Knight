root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,tscn,tres,godot}]
indent_style = tab
indent_size = 4

[*.{py,json,md,yml,yaml}]
indent_style = space
indent_size = 4

[*.{ps1,bat}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
