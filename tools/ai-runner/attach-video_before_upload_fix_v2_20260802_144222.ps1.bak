param(
    [string]$ProjectRoot = "C:\Users\Jimmy\Desktop\Broken Knight",
    [string]$VideoPath = ""
)

$ErrorActionPreference = "Stop"

$OutputDir = Join-Path $ProjectRoot "Powershell output"
$TestFile = Join-Path $OutputDir "test.txt"
$LogFile = Join-Path $OutputDir "ai-runner.log"

function Report([string]$m) {
    Add-Content -LiteralPath $TestFile -Value $m -Encoding UTF8
}
function Log([string]$m) {
    Add-Content -LiteralPath $LogFile -Value ("{0} | {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"),$m) -Encoding UTF8
}

if (-not (Test-Path -LiteralPath $VideoPath -PathType Leaf)) {
    Report "AUTO_UPLOAD: FAILED - AVI missing"
    Log "UPLOAD_FAILED|AVI missing|$VideoPath"
    exit 3
}

Add-Type -AssemblyName UIAutomationClient
Add-Type -AssemblyName UIAutomationTypes
Add-Type -AssemblyName System.Windows.Forms

function Desc($root) {
    return $root.FindAll(
        [System.Windows.Automation.TreeScope]::Descendants,
        [System.Windows.Automation.Condition]::TrueCondition
    )
}
function ById($root,[string]$id) {
    $c = New-Object System.Windows.Automation.PropertyCondition(
        [System.Windows.Automation.AutomationElement]::AutomationIdProperty,$id
    )
    return $root.FindFirst([System.Windows.Automation.TreeScope]::Descendants,$c)
}
function Chat {
    foreach ($p in @(Get-Process firefox -ErrorAction SilentlyContinue | Where-Object {$_.MainWindowHandle -ne 0})) {
        try {
            $root = [System.Windows.Automation.AutomationElement]::FromHandle($p.MainWindowHandle)
            $url = ById $root "urlbar-input"
            if ($url -and ([string]$url.Current.Name -match '^https://chatgpt\.com/')) {
                return [pscustomobject]@{ Process=$p; Root=$root }
            }
        } catch {}
    }
    return $null
}
function FileDialog {
    $desktop = [System.Windows.Automation.AutomationElement]::RootElement
    foreach ($w in $desktop.FindAll([System.Windows.Automation.TreeScope]::Children,[System.Windows.Automation.Condition]::TrueCondition)) {
        try {
            if (-not $w.Current.IsOffscreen -and (ById $w "1148")) { return $w }
        } catch {}
    }
    return $null
}
function WaitDialog([int]$ms) {
    $n = [Math]::Ceiling($ms/150.0)
    for ($i=0;$i-lt$n;$i++) {
        Start-Sleep -Milliseconds 150
        $d = FileDialog
        if ($d) { return $d }
    }
    return $null
}

$chat = Chat
if (-not $chat) {
    Report "AUTO_UPLOAD: FAILED - ChatGPT Firefox tab not found"
    Log "UPLOAD_FAILED|ChatGPT tab not found"
    exit 4
}

$ws = New-Object -ComObject WScript.Shell
[void]$ws.AppActivate($chat.Process.Id)
Start-Sleep -Milliseconds 400

$chat = Chat
$plus = ById $chat.Root "composer-plus-btn"
if (-not $plus) {
    Report "AUTO_UPLOAD: FAILED - composer plus button not found"
    Log "UPLOAD_FAILED|composer-plus-btn missing"
    exit 5
}

try {
    $plus.SetFocus()
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
} catch {
    Report "AUTO_UPLOAD: FAILED - could not open attachment menu"
    Log "UPLOAD_FAILED|plus activation"
    exit 6
}

Start-Sleep -Milliseconds 400

# Bounded keyboard path that succeeded in the previous V10 test.
[System.Windows.Forms.SendKeys]::SendWait("{HOME}")
Start-Sleep -Milliseconds 100
[System.Windows.Forms.SendKeys]::SendWait("{ENTER}")

$dialog = WaitDialog 1800
if (-not $dialog) {
    [System.Windows.Forms.SendKeys]::SendWait("{HOME}")
    Start-Sleep -Milliseconds 100
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
    $dialog = WaitDialog 2200
}

if (-not $dialog) {
    [System.Windows.Forms.SendKeys]::SendWait("{ESC}{ESC}")
    Report "AUTO_UPLOAD: FAILED - Windows file chooser did not appear"
    Log "UPLOAD_FAILED|no file chooser"
    exit 10
}

$field = ById $dialog "1148"
$filled = $false
try {
    $vp = $null
    if ($field.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern,[ref]$vp)) {
        ([System.Windows.Automation.ValuePattern]$vp).SetValue($VideoPath)
        $filled = $true
    }
} catch {}

if (-not $filled) {
    try {
        [System.Windows.Forms.Clipboard]::SetText($VideoPath)
        $field.SetFocus()
        [System.Windows.Forms.SendKeys]::SendWait("^a")
        [System.Windows.Forms.SendKeys]::SendWait("^v")
        $filled = $true
    } catch {}
}

if (-not $filled) {
    Report "AUTO_UPLOAD: FAILED - could not fill file path"
    Log "UPLOAD_FAILED|fill path"
    exit 11
}

Start-Sleep -Milliseconds 200

$open = ById $dialog "1"
$opened = $false
if ($open) {
    try {
        $inv = $null
        if ($open.TryGetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern,[ref]$inv)) {
            ([System.Windows.Automation.InvokePattern]$inv).Invoke()
            $opened = $true
        }
    } catch {}
}

if (-not $opened) {
    try {
        $field.SetFocus()
        [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
        $opened = $true
    } catch {}
}

if (-not $opened) {
    Report "AUTO_UPLOAD: FAILED - could not press Open"
    Log "UPLOAD_FAILED|press Open"
    exit 12
}

Report "AUTO_UPLOAD_SUBMITTED: $VideoPath"
Log "UPLOAD_SUBMITTED|$VideoPath"

Start-Sleep -Seconds 1
[void]$ws.AppActivate($chat.Process.Id)

$basename = [IO.Path]::GetFileName($VideoPath)
$verified = $false

for ($i=0;$i-lt40;$i++) {
    Start-Sleep -Milliseconds 250
    $c = Chat
    if (-not $c) { continue }
    foreach ($e in (Desc $c.Root)) {
        try {
            if ([string]$e.Current.Name -like "*$basename*") {
                $verified = $true
                break
            }
        } catch {}
    }
    if ($verified) { break }
}

if ($verified) {
    Report "AUTO_UPLOAD_VERIFIED: $basename"
    Report "AUTO_UPLOAD_RESULT: SUCCESS"
    Log "UPLOAD_SUCCESS|$VideoPath"
} else {
    Report "AUTO_UPLOAD_RESULT: SUBMITTED_UNVERIFIED"
    Log "UPLOAD_SUBMITTED_UNVERIFIED|$VideoPath"
}

exit 0
