param(
    [string]$ProjectRoot = "C:\Users\Jimmy\Desktop\Broken Knight",
    [string]$VideoPath = ""
)

$ErrorActionPreference = "Stop"

$OutputDir = Join-Path $ProjectRoot "Powershell output"
$TestFile = Join-Path $OutputDir "test.txt"
$LogFile = Join-Path $OutputDir "ai-runner.log"

New-Item -ItemType Directory -Force -Path $OutputDir | Out-Null

function Report([string]$m) {
    Add-Content -LiteralPath $TestFile -Value $m -Encoding UTF8
}
function Log([string]$m) {
    Add-Content -LiteralPath $LogFile -Value ("{0} | {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"),$m) -Encoding UTF8
}

try {
    Report "UPLOAD_V3_STAGE: START"

    if (-not (Test-Path -LiteralPath $VideoPath -PathType Leaf)) {
        Report "UPLOAD_RESULT: FAILED - file missing"
        Report "UPLOAD_FILE_PATH: $VideoPath"
        exit 3
    }

    $VideoPath = [IO.Path]::GetFullPath($VideoPath)
    $BaseName = [IO.Path]::GetFileName($VideoPath)

    Report "UPLOAD_FILE_EXISTS: YES"
    Report "UPLOAD_FILE_PATH: $VideoPath"
    Report "UPLOAD_FILE_BYTES: $((Get-Item -LiteralPath $VideoPath).Length)"

    Add-Type -AssemblyName UIAutomationClient
    Add-Type -AssemblyName UIAutomationTypes
    Add-Type -AssemblyName System.Windows.Forms

    Add-Type @"
using System;
using System.Runtime.InteropServices;
public static class BKUploadV3Native {
    [DllImport("user32.dll")]
    public static extern bool SetForegroundWindow(IntPtr hWnd);
}
"@

    function Desc($root) {
        return $root.FindAll(
            [System.Windows.Automation.TreeScope]::Descendants,
            [System.Windows.Automation.Condition]::TrueCondition
        )
    }

    function ById($root,[string]$id) {
        $cond = New-Object System.Windows.Automation.PropertyCondition(
            [System.Windows.Automation.AutomationElement]::AutomationIdProperty,$id
        )
        return $root.FindFirst([System.Windows.Automation.TreeScope]::Descendants,$cond)
    }

    function Chat {
        foreach ($p in @(Get-Process firefox -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -ne 0 })) {
            try {
                $root = [System.Windows.Automation.AutomationElement]::FromHandle($p.MainWindowHandle)
                $url = ById $root "urlbar-input"
                if ($url -and ([string]$url.Current.Name -match '^https://chatgpt\.com/')) {
                    return [pscustomobject]@{
                        Process = $p
                        Root = $root
                        Url = [string]$url.Current.Name
                    }
                }
            } catch {}
        }
        return $null
    }

    function Element-Info($e) {
        if (-not $e) { return "<null>" }
        try {
            $r = $e.Current.BoundingRectangle
            return ("type={0}|name={1}|aid={2}|class={3}|focus={4}|offscreen={5}|rect={6},{7},{8},{9}" -f
                [string]$e.Current.ControlType.ProgrammaticName,
                [string]$e.Current.Name,
                [string]$e.Current.AutomationId,
                [string]$e.Current.ClassName,
                $e.Current.IsKeyboardFocusable,
                $e.Current.IsOffscreen,
                [int]$r.X,[int]$r.Y,[int]$r.Width,[int]$r.Height)
        } catch {
            return "<unavailable>"
        }
    }

    function Find-NearByName($root,[string]$name,$nearRect) {
        $matches = @()

        foreach ($e in (Desc $root)) {
            try {
                if ([string]$e.Current.Name -ne $name) { continue }
                if ($e.Current.IsOffscreen) { continue }

                $r = $e.Current.BoundingRectangle
                if ($r.Width -le 0 -or $r.Height -le 0) { continue }

                $cx = $r.X + ($r.Width / 2.0)
                $cy = $r.Y + ($r.Height / 2.0)
                $nx = $nearRect.X + ($nearRect.Width / 2.0)
                $ny = $nearRect.Y + ($nearRect.Height / 2.0)
                $dist = [Math]::Sqrt([Math]::Pow($cx-$nx,2)+[Math]::Pow($cy-$ny,2))

                # Keep menu-sized items near the composer first.
                $matches += [pscustomobject]@{
                    Element=$e
                    Distance=$dist
                }
            } catch {}
        }

        if ($matches.Count -eq 0) { return $null }
        return ($matches | Sort-Object Distance | Select-Object -First 1).Element
    }

    function Parent-Chain($e,[int]$max=7) {
        $items = New-Object System.Collections.Generic.List[object]
        if (-not $e) { return $items }

        $walker = [System.Windows.Automation.TreeWalker]::RawViewWalker
        $cur = $e
        $items.Add($cur)

        for ($i=0;$i-lt$max;$i++) {
            try { $cur = $walker.GetParent($cur) } catch { $cur = $null }
            if (-not $cur) { break }
            $items.Add($cur)
        }

        return $items
    }

    function Supports-Action($e) {
        if (-not $e) { return $false }

        try {
            $obj=$null
            if ($e.TryGetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern,[ref]$obj)) {
                return $true
            }
        } catch {}

        try {
            $obj=$null
            if ($e.TryGetCurrentPattern([System.Windows.Automation.LegacyIAccessiblePattern]::Pattern,[ref]$obj)) {
                $legacy=[System.Windows.Automation.LegacyIAccessiblePattern]$obj
                if (-not [string]::IsNullOrWhiteSpace([string]$legacy.Current.DefaultAction)) {
                    return $true
                }
            }
        } catch {}

        try {
            if ($e.Current.IsKeyboardFocusable) { return $true }
        } catch {}

        return $false
    }

    function Activate-One($e,[string]$label) {
        if (-not $e) { return $false }

        Report "UPLOAD_ACTION_TARGET: $label | $(Element-Info $e)"

        try {
            $obj=$null
            if ($e.TryGetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern,[ref]$obj)) {
                ([System.Windows.Automation.InvokePattern]$obj).Invoke()
                Report "UPLOAD_ACTION_METHOD: InvokePattern"
                return $true
            }
        } catch {
            Report "UPLOAD_ACTION_INVOKE_ERROR: $($_.Exception.Message)"
        }

        try {
            $obj=$null
            if ($e.TryGetCurrentPattern([System.Windows.Automation.LegacyIAccessiblePattern]::Pattern,[ref]$obj)) {
                $legacy=[System.Windows.Automation.LegacyIAccessiblePattern]$obj
                if (-not [string]::IsNullOrWhiteSpace([string]$legacy.Current.DefaultAction)) {
                    $legacy.DoDefaultAction()
                    Report "UPLOAD_ACTION_METHOD: LegacyDefaultAction"
                    return $true
                }
            }
        } catch {
            Report "UPLOAD_ACTION_LEGACY_ERROR: $($_.Exception.Message)"
        }

        try {
            $e.SetFocus()
            Start-Sleep -Milliseconds 100
            [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
            Report "UPLOAD_ACTION_METHOD: FocusEnter"
            return $true
        } catch {
            Report "UPLOAD_ACTION_ENTER_ERROR: $($_.Exception.Message)"
        }

        return $false
    }

    function First-ClickableAncestor($e) {
        $chain = Parent-Chain $e 7

        for ($i=0;$i-lt$chain.Count;$i++) {
            $candidate = $chain[$i]

            try {
                $type = [string]$candidate.Current.ControlType.ProgrammaticName
                if ($type -match '(Document|Window)$') { break }

                if (
                    $type -match '(Button|MenuItem|ListItem|Hyperlink)$' -and
                    (Supports-Action $candidate)
                ) {
                    return $candidate
                }
            } catch {}
        }

        # If semantic type didn't help, use the first actionable non-document ancestor.
        for ($i=0;$i-lt$chain.Count;$i++) {
            $candidate = $chain[$i]
            try {
                $type = [string]$candidate.Current.ControlType.ProgrammaticName
                if ($type -match '(Document|Window)$') { break }
                if (Supports-Action $candidate) { return $candidate }
            } catch {}
        }

        return $null
    }

    function Dump-MenuCandidates($root,$plusRect,[string]$tag) {
        Report "UPLOAD_MENU_DIAGNOSTIC: $tag"

        foreach ($name in @(
            "Add file",
            "Add photos & files",
            "Upload from computer",
            "Add from library"
        )) {
            $e = Find-NearByName $root $name $plusRect
            if ($e) {
                Report "UPLOAD_MENU_CANDIDATE: $name | $(Element-Info $e)"
                $chain = Parent-Chain $e 5
                for ($i=0;$i-lt$chain.Count;$i++) {
                    Report "UPLOAD_MENU_PARENT_$i: $name | $(Element-Info $chain[$i])"
                }
            } else {
                Report "UPLOAD_MENU_CANDIDATE: $name | NOT FOUND"
            }
        }
    }

    function Find-RealFileDialog {
        $desktop = [System.Windows.Automation.AutomationElement]::RootElement

        foreach ($w in $desktop.FindAll(
            [System.Windows.Automation.TreeScope]::Children,
            [System.Windows.Automation.Condition]::TrueCondition
        )) {
            try {
                if ($w.Current.IsOffscreen) { continue }

                $className = [string]$w.Current.ClassName
                if ($className -ne "#32770") { continue }

                $fileNameControl = ById $w "1148"
                if (-not $fileNameControl) { continue }

                $hasOpen = $false
                foreach ($e in (Desc $w)) {
                    try {
                        $type = [string]$e.Current.ControlType.ProgrammaticName
                        $name = [string]$e.Current.Name
                        if ($type -match 'Button$' -and $name -match '^(Open|Choose|Select)$') {
                            $hasOpen = $true
                            break
                        }
                    } catch {}
                }

                if ($hasOpen) { return $w }
            } catch {}
        }

        return $null
    }

    function Wait-RealFileDialog([int]$milliseconds) {
        $loops = [Math]::Ceiling($milliseconds / 150.0)

        for ($i=0;$i-lt$loops;$i++) {
            Start-Sleep -Milliseconds 150
            $d = Find-RealFileDialog
            if ($d) { return $d }
        }

        return $null
    }

    function Wait-DialogClosed([int]$milliseconds) {
        $loops = [Math]::Ceiling($milliseconds / 150.0)

        for ($i=0;$i-lt$loops;$i++) {
            Start-Sleep -Milliseconds 150
            if (-not (Find-RealFileDialog)) { return $true }
        }

        return $false
    }

    function Read-FieldValue($dialog) {
        $outer = ById $dialog "1148"
        if (-not $outer) { return "" }

        try {
            $vp=$null
            if ($outer.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern,[ref]$vp)) {
                return [string]([System.Windows.Automation.ValuePattern]$vp).Current.Value
            }
        } catch {}

        foreach ($e in (Desc $outer)) {
            try {
                $vp=$null
                if ($e.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern,[ref]$vp)) {
                    return [string]([System.Windows.Automation.ValuePattern]$vp).Current.Value
                }
            } catch {}
        }

        return ""
    }

    function Verify-ChatAttachment([string]$basename,[int]$seconds) {
        for ($i=0;$i-lt($seconds*4);$i++) {
            Start-Sleep -Milliseconds 250
            $c=Chat
            if (-not $c) { continue }

            foreach ($e in (Desc $c.Root)) {
                try {
                    $n=[string]$e.Current.Name
                    if ($n -like "*$basename*") { return $true }

                    if ($n -match '(?i)(unsupported|failed to upload|upload failed|file type|could not upload)') {
                        Report "UPLOAD_CHATGPT_MESSAGE: $n"
                    }
                } catch {}
            }
        }

        return $false
    }

    Report "UPLOAD_V3_STAGE: FIND_CHATGPT"

    $chat = Chat
    if (-not $chat) {
        Report "UPLOAD_RESULT: FAILED - ChatGPT Firefox tab not found"
        exit 4
    }

    Report "UPLOAD_CHATGPT: FOUND"
    Report "UPLOAD_CHATGPT_URL: $($chat.Url)"

    $ws = New-Object -ComObject WScript.Shell
    [void]$ws.AppActivate($chat.Process.Id)
    Start-Sleep -Milliseconds 400

    $chat = Chat
    $plus = ById $chat.Root "composer-plus-btn"
    if (-not $plus) {
        Report "UPLOAD_RESULT: FAILED - composer plus button not found"
        exit 5
    }

    $plusRect = $plus.Current.BoundingRectangle

    Report "UPLOAD_V3_STAGE: OPEN_PLUS"
    Report "UPLOAD_PLUS: $(Element-Info $plus)"

    if (-not (Activate-One $plus "composer-plus-btn")) {
        Report "UPLOAD_RESULT: FAILED - could not activate composer plus"
        exit 6
    }

    Start-Sleep -Milliseconds 500
    $chat = Chat
    Dump-MenuCandidates $chat.Root $plusRect "AFTER_PLUS"

    # Step 1: exact visible Add file button.
    $addFile = Find-NearByName $chat.Root "Add file" $plusRect
    if ($addFile) {
        Report "UPLOAD_V3_STAGE: ACTIVATE_ADD_FILE"
        [void](Activate-One $addFile "Add file")
        $dialog = Wait-RealFileDialog 1200
        if ($dialog) {
            Report "UPLOAD_REAL_FILE_CHOOSER: FOUND_AFTER_ADD_FILE"
        }
    } else {
        $dialog = $null
    }

    # Step 2: if Add file exposed another menu instead of a chooser,
    # activate the exact "Upload from computer" item or its first clickable ancestor.
    if (-not $dialog) {
        Start-Sleep -Milliseconds 350
        $chat = Chat
        Dump-MenuCandidates $chat.Root $plusRect "AFTER_ADD_FILE"

        $uploadText = Find-NearByName $chat.Root "Upload from computer" $plusRect
        if ($uploadText) {
            $target = First-ClickableAncestor $uploadText
            if (-not $target) { $target = $uploadText }

            Report "UPLOAD_V3_STAGE: ACTIVATE_UPLOAD_FROM_COMPUTER"
            [void](Activate-One $target "Upload from computer")
            $dialog = Wait-RealFileDialog 1700
        }
    }

    # Step 3: bounded fallback for current ChatGPT wording.
    if (-not $dialog) {
        $chat = Chat
        $photosText = Find-NearByName $chat.Root "Add photos & files" $plusRect
        if ($photosText) {
            $target = First-ClickableAncestor $photosText
            if (-not $target) { $target = $photosText }

            Report "UPLOAD_V3_STAGE: ACTIVATE_ADD_PHOTOS_FILES"
            [void](Activate-One $target "Add photos & files")
            $dialog = Wait-RealFileDialog 1700
        }
    }

    if (-not $dialog) {
        Report "UPLOAD_RESULT: FAILED - ChatGPT upload menu never opened a real Windows file chooser"
        Log "APP_UPLOAD_V3_FAILED|menu action did not create real file chooser"
        exit 10
    }

    Report "UPLOAD_REAL_FILE_CHOOSER: FOUND"
    Report "UPLOAD_DIALOG_TITLE: $($dialog.Current.Name)"
    Report "UPLOAD_DIALOG_CLASS: $($dialog.Current.ClassName)"
    Report "UPLOAD_DIALOG_PID: $($dialog.Current.ProcessId)"

    $hwnd = [IntPtr]([int64]$dialog.Current.NativeWindowHandle)
    if ($hwnd -ne [IntPtr]::Zero) {
        [void][BKUploadV3Native]::SetForegroundWindow($hwnd)
    }
    Start-Sleep -Milliseconds 250

    Report "UPLOAD_V3_STAGE: ENTER_FILENAME"

    [System.Windows.Forms.Clipboard]::SetText($VideoPath)
    [System.Windows.Forms.SendKeys]::SendWait("%n")
    Start-Sleep -Milliseconds 180
    [System.Windows.Forms.SendKeys]::SendWait("^a")
    Start-Sleep -Milliseconds 80
    [System.Windows.Forms.SendKeys]::SendWait("^v")
    Start-Sleep -Milliseconds 250

    $readback = Read-FieldValue $dialog
    Report "UPLOAD_FILENAME_READBACK: $readback"

    Report "UPLOAD_V3_STAGE: PRESS_OPEN"

    [System.Windows.Forms.SendKeys]::SendWait("%o")
    Start-Sleep -Milliseconds 300

    if (-not (Wait-DialogClosed 3500)) {
        [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
        if (-not (Wait-DialogClosed 1800)) {
            Report "UPLOAD_RESULT: FAILED - real chooser stayed open after filename + Open"
            exit 12
        }
    }

    Report "UPLOAD_SUBMITTED: $VideoPath"
    Log "APP_UPLOAD_V3_SUBMITTED|$VideoPath"

    Start-Sleep -Seconds 1
    [void]$ws.AppActivate($chat.Process.Id)

    Report "UPLOAD_V3_STAGE: VERIFY_CHATGPT"

    if (Verify-ChatAttachment $BaseName 12) {
        Report "UPLOAD_VERIFIED: $BaseName"
        Report "UPLOAD_RESULT: SUCCESS"
        Log "APP_UPLOAD_V3_VERIFIED|$VideoPath"
        exit 0
    }

    Report "UPLOAD_RESULT: SUBMITTED_UNVERIFIED"
    Log "APP_UPLOAD_V3_SUBMITTED_UNVERIFIED|$VideoPath"
    exit 0

} catch {
    Report "UPLOAD_RESULT: CRASH"
    Report "UPLOAD_EXCEPTION_TYPE: $($_.Exception.GetType().FullName)"
    Report "UPLOAD_EXCEPTION_MESSAGE: $($_.Exception.Message)"
    Report "UPLOAD_EXCEPTION_LINE: $($_.InvocationInfo.ScriptLineNumber)"
    Report "UPLOAD_EXCEPTION_TEXT: $($_.InvocationInfo.Line)"
    Log "APP_UPLOAD_V3_CRASH|$($_.Exception.Message)"
    exit 99
}
