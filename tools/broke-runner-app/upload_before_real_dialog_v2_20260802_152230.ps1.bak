param(
    [string]$ProjectRoot = "C:\Users\Jimmy\Desktop\Broken Knight",
    [string]$VideoPath = ""
)

$ErrorActionPreference = "Stop"

$OutputDir = Join-Path $ProjectRoot "Powershell output"
$TestFile = Join-Path $OutputDir "test.txt"
$LogFile = Join-Path $OutputDir "ai-runner.log"

New-Item -ItemType Directory -Force -Path $OutputDir | Out-Null

function Report([string]$m) {
    Add-Content -LiteralPath $TestFile -Value $m -Encoding UTF8
}
function Log([string]$m) {
    Add-Content -LiteralPath $LogFile -Value ("{0} | {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"),$m) -Encoding UTF8
}

try {
    Report "UPLOAD_V2_STAGE: START"

    if (-not (Test-Path -LiteralPath $VideoPath -PathType Leaf)) {
        Report "UPLOAD_RESULT: FAILED - AVI missing"
        Report "UPLOAD_VIDEO_PATH: $VideoPath"
        exit 3
    }

    $VideoPath = [IO.Path]::GetFullPath($VideoPath)
    $BaseName = [IO.Path]::GetFileName($VideoPath)

    Report "UPLOAD_VIDEO_EXISTS: YES"
    Report "UPLOAD_VIDEO_PATH: $VideoPath"
    Report "UPLOAD_VIDEO_BYTES: $((Get-Item -LiteralPath $VideoPath).Length)"

    Add-Type -AssemblyName UIAutomationClient
    Add-Type -AssemblyName UIAutomationTypes
    Add-Type -AssemblyName System.Windows.Forms

    Add-Type @"
using System;
using System.Runtime.InteropServices;
public static class BKUploadForegroundOnly {
    [DllImport("user32.dll")]
    public static extern bool SetForegroundWindow(IntPtr hWnd);
}
"@

    function Desc($root) {
        return $root.FindAll(
            [System.Windows.Automation.TreeScope]::Descendants,
            [System.Windows.Automation.Condition]::TrueCondition
        )
    }

    function ById($root,[string]$id) {
        $cond = New-Object System.Windows.Automation.PropertyCondition(
            [System.Windows.Automation.AutomationElement]::AutomationIdProperty,$id
        )
        return $root.FindFirst(
            [System.Windows.Automation.TreeScope]::Descendants,
            $cond
        )
    }

    function Chat {
        foreach ($p in @(Get-Process firefox -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -ne 0 })) {
            try {
                $root = [System.Windows.Automation.AutomationElement]::FromHandle($p.MainWindowHandle)
                $url = ById $root "urlbar-input"
                if ($url -and ([string]$url.Current.Name -match '^https://chatgpt\.com/')) {
                    return [pscustomobject]@{
                        Process = $p
                        Root = $root
                    }
                }
            } catch {}
        }
        return $null
    }

    function Find-RealFileDialog {
        $desktop = [System.Windows.Automation.AutomationElement]::RootElement

        foreach ($w in $desktop.FindAll(
            [System.Windows.Automation.TreeScope]::Children,
            [System.Windows.Automation.Condition]::TrueCondition
        )) {
            try {
                if ($w.Current.IsOffscreen) { continue }

                $className = [string]$w.Current.ClassName
                if ($className -ne "#32770") { continue }

                $fileNameControl = ById $w "1148"
                if (-not $fileNameControl) { continue }

                $hasOpen = $false
                foreach ($e in (Desc $w)) {
                    try {
                        $type = [string]$e.Current.ControlType.ProgrammaticName
                        $name = [string]$e.Current.Name
                        if ($type -match 'Button$' -and $name -match '^(Open|Choose|Select)$') {
                            $hasOpen = $true
                            break
                        }
                    } catch {}
                }

                if (-not $hasOpen) { continue }

                return $w
            } catch {}
        }

        return $null
    }

    function Wait-RealFileDialog([int]$milliseconds) {
        $loops = [Math]::Ceiling($milliseconds / 150.0)

        for ($i=0; $i -lt $loops; $i++) {
            Start-Sleep -Milliseconds 150
            $dialog = Find-RealFileDialog
            if ($dialog) { return $dialog }
        }

        return $null
    }

    function Wait-DialogClosed([int]$milliseconds) {
        $loops = [Math]::Ceiling($milliseconds / 150.0)

        for ($i=0; $i -lt $loops; $i++) {
            Start-Sleep -Milliseconds 150
            if (-not (Find-RealFileDialog)) { return $true }
        }

        return $false
    }

    function Read-FileNameValue($dialog) {
        $control = ById $dialog "1148"
        if (-not $control) { return "" }

        try {
            $vp = $null
            if ($control.TryGetCurrentPattern(
                [System.Windows.Automation.ValuePattern]::Pattern,
                [ref]$vp
            )) {
                return [string]([System.Windows.Automation.ValuePattern]$vp).Current.Value
            }
        } catch {}

        foreach ($e in (Desc $control)) {
            try {
                $vp = $null
                if ($e.TryGetCurrentPattern(
                    [System.Windows.Automation.ValuePattern]::Pattern,
                    [ref]$vp
                )) {
                    return [string]([System.Windows.Automation.ValuePattern]$vp).Current.Value
                }
            } catch {}
        }

        return ""
    }

    function Verify-ChatAttachment([string]$basename,[int]$seconds) {
        for ($i=0; $i -lt ($seconds * 4); $i++) {
            Start-Sleep -Milliseconds 250
            $c = Chat
            if (-not $c) { continue }

            foreach ($e in (Desc $c.Root)) {
                try {
                    $n = [string]$e.Current.Name
                    if ($n -like "*$basename*") {
                        return $true
                    }

                    if ($n -match '(?i)(unsupported|failed to upload|upload failed|file type|could not upload)') {
                        Report "UPLOAD_CHATGPT_MESSAGE: $n"
                    }
                } catch {}
            }
        }

        return $false
    }

    Report "UPLOAD_V2_STAGE: FIND_CHATGPT"

    $chat = Chat
    if (-not $chat) {
        Report "UPLOAD_RESULT: FAILED - ChatGPT Firefox tab not found"
        exit 4
    }

    Report "UPLOAD_CHATGPT: FOUND"

    $ws = New-Object -ComObject WScript.Shell
    [void]$ws.AppActivate($chat.Process.Id)
    Start-Sleep -Milliseconds 400

    $chat = Chat
    $plus = ById $chat.Root "composer-plus-btn"

    if (-not $plus) {
        Report "UPLOAD_RESULT: FAILED - composer plus button not found"
        exit 5
    }

    Report "UPLOAD_V2_STAGE: OPEN_CHATGPT_MENU"

    $plus.SetFocus()
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
    Start-Sleep -Milliseconds 400

    # Bounded keyboard navigation only.
    [System.Windows.Forms.SendKeys]::SendWait("{HOME}")
    Start-Sleep -Milliseconds 100
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")

    Report "UPLOAD_V2_STAGE: WAIT_REAL_FILE_DIALOG"

    $dialog = Wait-RealFileDialog 1800

    if (-not $dialog) {
        [System.Windows.Forms.SendKeys]::SendWait("{HOME}")
        Start-Sleep -Milliseconds 100
        [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
        $dialog = Wait-RealFileDialog 2200
    }

    if (-not $dialog) {
        [System.Windows.Forms.SendKeys]::SendWait("{ESC}{ESC}")
        Report "UPLOAD_RESULT: FAILED - real Windows file chooser did not appear"
        exit 10
    }

    Report "UPLOAD_REAL_FILE_CHOOSER: FOUND"
    Report "UPLOAD_DIALOG_TITLE: $($dialog.Current.Name)"
    Report "UPLOAD_DIALOG_CLASS: $($dialog.Current.ClassName)"
    Report "UPLOAD_DIALOG_PID: $($dialog.Current.ProcessId)"

    $hwnd = [IntPtr]([int64]$dialog.Current.NativeWindowHandle)
    if ($hwnd -eq [IntPtr]::Zero) {
        Report "UPLOAD_RESULT: FAILED - real dialog has no native window handle"
        exit 11
    }

    [void][BKUploadForegroundOnly]::SetForegroundWindow($hwnd)
    Start-Sleep -Milliseconds 250

    Report "UPLOAD_V2_STAGE: ENTER_FILENAME"

    # On a genuine Windows common file dialog, Alt+N focuses File name.
    [System.Windows.Forms.Clipboard]::SetText($VideoPath)
    [System.Windows.Forms.SendKeys]::SendWait("%n")
    Start-Sleep -Milliseconds 180
    [System.Windows.Forms.SendKeys]::SendWait("^a")
    Start-Sleep -Milliseconds 80
    [System.Windows.Forms.SendKeys]::SendWait("^v")
    Start-Sleep -Milliseconds 250

    $readback = Read-FileNameValue $dialog
    Report "UPLOAD_FILENAME_READBACK: $readback"

    # If UIA readback is blank, don't falsely fail yet; the keyboard text may
    # still be present in the native edit. Press Open once and judge by whether
    # the real file dialog closes.
    Report "UPLOAD_V2_STAGE: PRESS_OPEN"

    [System.Windows.Forms.SendKeys]::SendWait("%o")
    Start-Sleep -Milliseconds 300

    if (-not (Wait-DialogClosed 3500)) {
        # One final Enter, still bounded.
        [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
        if (-not (Wait-DialogClosed 1800)) {
            Report "UPLOAD_RESULT: FAILED - real chooser stayed open after File name + Open"
            exit 12
        }
    }

    Report "UPLOAD_SUBMITTED: $VideoPath"
    Log "APP_UPLOAD_V2_SUBMITTED|$VideoPath"

    Start-Sleep -Seconds 1
    [void]$ws.AppActivate($chat.Process.Id)

    Report "UPLOAD_V2_STAGE: VERIFY_CHATGPT"

    if (Verify-ChatAttachment $BaseName 12) {
        Report "UPLOAD_VERIFIED: $BaseName"
        Report "UPLOAD_RESULT: SUCCESS"
        Log "APP_UPLOAD_V2_VERIFIED|$VideoPath"
        exit 0
    }

    Report "UPLOAD_RESULT: SUBMITTED_UNVERIFIED"
    Log "APP_UPLOAD_V2_SUBMITTED_UNVERIFIED|$VideoPath"
    exit 0

} catch {
    Report "UPLOAD_RESULT: CRASH"
    Report "UPLOAD_EXCEPTION_TYPE: $($_.Exception.GetType().FullName)"
    Report "UPLOAD_EXCEPTION_MESSAGE: $($_.Exception.Message)"
    Report "UPLOAD_EXCEPTION_LINE: $($_.InvocationInfo.ScriptLineNumber)"
    Report "UPLOAD_EXCEPTION_TEXT: $($_.InvocationInfo.Line)"
    Log "APP_UPLOAD_V2_CRASH|$($_.Exception.Message)"
    exit 99
}
